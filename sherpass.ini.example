; Sherpass configuration.
;
; Copy to sherpass.ini next to this file, or anywhere else and point the
; SHERPASS_CONFIG environment variable to it.

; Public URL of the site, used to build the links sent by mail. Must be
; https, plain http is only accepted for localhost.
base_url = "https://pass.allard.it"

; Sender of every mail.
mail_from = "sherpass@allard.it"
mail_from_name = "Sherpass"

; Domains whose addresses may share a password. Exact match, subdomains
; are not included. Repeat the line for each domain.
allowed_domains[] = "allard.it"

; SQLite database, absolute path. Its directory must be writable by the
; PHP user and lie outside the web root.
db_path = "/var/lib/sherpass/sherpass.db"

; The settings below are optional, the values shown are the defaults.

; Lifetime of an unclaimed password, in seconds (30 days).
secret_ttl = 2592000

; Lifetime of the links sent by mail, in seconds (30 minutes).
token_ttl = 1800

; Rate limits, counted over the last hour. Addresses entered on the start
; page or on a share page, per IPv4 address or IPv6 /64. Raise it if many
; users share one address.
ip_limit = 30

; Sender mails per address.
sender_limit = 3

; Recipient mails per password.
recipient_limit = 3

; Minimum delay between two recipient mails for the same password, in
; seconds, at most 3600.
recipient_delay = 60

; Mail delivery: sendmail hands mails to the local MTA through PHP
; mail(), smtp talks to an SMTP server directly.
;mail_transport = sendmail

; SMTP server, mandatory with mail_transport = smtp.
;smtp_host = "smtp.example.org"

; tls for TLS from the start, starttls to upgrade a plain connection,
; off for a relay without TLS on localhost, 127.0.0.0/8 or ::1. The port
; defaults to 465, 587 or 25.
;smtp_tls = tls
;smtp_port = 465

; Credentials, only ever sent over TLS. Keep them between single quotes,
; inside double quotes ${...} is expanded.
;smtp_user = 'sherpass@allard.it'
;smtp_password = 'secret'

; CA certificates to verify the server with, for a private CA. The
; system CAs are used otherwise.
;smtp_cafile = "/etc/sherpass/ca.pem"

; Certificate verification can only be turned off for a server on
; localhost, 127.0.0.0/8 or ::1.
;smtp_tls_verify = on
